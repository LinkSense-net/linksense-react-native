{
  "name": "@linksense/react-native",
  "version": "0.1.0",
  "description": "React Native Turbo Module for LinkSense dynamic links and deferred deep linking.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "LinkSense.podspec",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "linksense",
    "dynamic-links",
    "deep-linking",
    "attribution"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jankokalj/linksense-react-native.git"
  },
  "author": "LinkSense <support@linksense.net>",
  "license": "UNLICENSED",
  "private": false,
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/react": "^18.3.12",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "isolatedModules": true }]
    },
    "modulePathIgnorePatterns": ["<rootDir>/example/node_modules", "<rootDir>/lib/"]
  },
  "codegenConfig": {
    "name": "LinkSenseSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.linksense.reactnative"
    }
  }
}
