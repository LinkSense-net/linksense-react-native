{
  "name": "@linksense-net/react-native",
  "version": "0.2.0",
  "description": "LinkSense for Expo and React Native: deferred deep linking, app-open reporting and dynamic links.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "src",
    "android",
    "ios",
    "expo-module.config.json",
    "LICENSE",
    "!**/__tests__",
    "!android/build",
    "!ios/build"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "sync-ios-sdk": "scripts/sync-ios-sdk.sh",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "linksense",
    "deep-linking",
    "deferred-deep-linking",
    "attribution"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LinkSense-net/linksense-react-native.git"
  },
  "homepage": "https://linksense.net",
  "author": "LinkSense <support@linksense.net>",
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "expo": ">=53.0.0",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/react": "~19.1.0",
    "expo": "^54.0.38",
    "jest": "^29.7.0",
    "react": "^19.1.4",
    "react-native": "0.81.6",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/",
      "<rootDir>/build/"
    ]
  }
}
